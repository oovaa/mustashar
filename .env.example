# Telegram Bot Configuration
# Get from @BotFather: https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here

# LLM Provider API Keys (at least one required)
# Cerebras - Qwen 3-235B (fast, free tier available)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Groq - Llama-3.3-70b (fast, free tier available)
GROQ_API_KEY=your_groq_api_key_here

# Together AI - Various models
TOGETHER_AI_API_KEY=your_together_ai_api_key_here

# Cohere - command-a-03-2025 (for summarization)
COHERE_API_KEY=your_cohere_api_key_here

# Google GenAI - Gemini 2.5 Flash (for classification)
GOOGLE_API_KEY=your_google_genai_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here

# Embeddings (required for RAG)
# HuggingFace Inference API - BAAI/bge-m3
HF_API_KEY=your_huggingface_api_key_here

# Optional: Voyage AI embeddings (alternative to HF)
# VOYAGE_API_KEY=your_voyage_ai_api_key_here

# Database (auto-configured by Docker Compose)
# DATABASE_URL=postgres://mustashar_admin:somepass@db:5432/mustashar_db

# Logging level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# PostgreSQL password (used by Docker Compose)
POSTGRES_PASSWORD=somepass

# Application Environment (development, production)
NODE_ENV=production

# Polling mode (true = long polling, false/falsey = webhook)
# Long polling is simpler — no tunnel or public URL needed
# POLLING=true
